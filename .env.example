# Copie ce fichier en .env et remplis avec les valeurs du dashboard Supabase
# (Settings > API). La clé "publishable" est publique par design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optionnel — uniquement si retour à Mapbox (voir src/services/mapbox.js) :
# VITE_MAPBOX_TOKEN=

# Acces de developpement pour basculer l'interface en mode connecte.
# ATTENTION : toute variable VITE_* est inlinee dans le bundle au build,
# donc ces valeurs sont PUBLIQUES. C'est un interrupteur de confort, pas une
# barriere de securite. La vraie auth passera par Supabase Auth (v1).
VITE_ADMIN_ID=
VITE_ADMIN_CODE=
